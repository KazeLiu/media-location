{
  "name": "media-location",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:exifr --external:@ffmpeg-installer/ffmpeg --outfile=dist/server/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && pkg --config package.json dist/server/index.cjs --targets node22-win-x64 --output dist/media-location.exe && node scripts/windows-subsystem.cjs dist/media-location.exe"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@types/cors": "^2.8.19",
    "@types/earcut": "^3.0.0",
    "@types/express": "^5.0.1",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.13",
    "@yao-pkg/pkg": "^6.0.0",
    "concurrently": "^9.2.0",
    "earcut": "^3.0.2",
    "element-plus": "^2.14.1",
    "esbuild": "^0.25.5",
    "happy-dom": "^20.10.5",
    "lucide-vue-next": "^0.539.0",
    "mapbox-gl": "^3.24.1",
    "sass": "^1.100.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "pkg": {
    "assets": [
      "dist/client/index.html",
      "dist/client/assets/**/*"
    ],
    "outputPath": "dist",
    "scripts": [
      "dist/server/**/*.js"
    ]
  }
}
